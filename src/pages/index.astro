
---
const articles = [
  {
    category: "BUSINESS",
    title: "Why Great Businesses Don't Always Make Great Investments",
    description: "Understanding the difference between business performance and shareholder returns."
  },
  {
    category: "FIXED INCOME",
    title: "The Hidden Opportunities in Bond Markets",
    description: "How interest rates, duration and credit spreads influence bond returns."
  },
  {
    category: "INNOVATION",
    title: "Innovation, Competitive Advantage and Value Creation",
    description: "Exploring how innovation changes business economics."
  }
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Capital & Conviction — independent perspectives on business, markets and investing." />
  <title>Capital & Conviction | Business & Markets</title>
  <style>
    :root {
      --navy: #12243b;
      --gold: #c9a45c;
      --cream: #f8f6f0;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--cream);
      color: var(--navy);
      font-family: Georgia, serif;
      line-height: 1.7;
    }
    header {
      background: var(--navy);
      color: white;
      padding: 22px 7%;
    }
    .brand {
      font-size: 25px;
      font-weight: bold;
      letter-spacing: 1px;
    }
    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
      margin-top: 12px;
    }
    nav a { color: #e8dfcc; text-decoration: none; }
    .hero {
      background: var(--navy);
      color: white;
      padding: 90px 7%;
    }
    .eyebrow {
      color: var(--gold);
      font: bold 12px Arial, sans-serif;
      letter-spacing: 2px;
    }
    h1 {
      font-size: clamp(38px, 7vw, 76px);
      line-height: 1.12;
      max-width: 850px;
      margin: 20px 0;
    }
    .hero p {
      max-width: 650px;
      color: #d6dce4;
      font-size: 19px;
    }
    .button {
      display: inline-block;
      margin-top: 22px;
      background: var(--gold);
      color: var(--navy);
      padding: 12px 22px;
      text-decoration: none;
      font: bold 14px Arial, sans-serif;
    }
    main { max-width: 1150px; margin: auto; padding: 55px 7%; }
    h2 { font-size: 34px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    article {
      background: white;
      padding: 25px;
      border-top: 3px solid var(--gold);
    }
    article h3 { font-size: 24px; line-height: 1.3; }
    article p { color: #596574; }
    .newsletter {
      background: #eae5d8;
      padding: 35px;
      margin-top: 55px;
    }
    footer {
      padding: 35px 7%;
      background: var(--navy);
      color: #d6dce4;
      text-align: center;
    }
    @media(max-width: 700px) {
      .grid { grid-template-columns: 1fr; }
      .hero { padding: 65px 7%; }
      h2 { font-size: 28px; }
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">CAPITAL & CONVICTION</div>
    <nav>
      <a href="/">Home</a>
      <a href="#insights">Insights</a>
      <a href="#newsletter">Newsletter</a>
    </nav>
  </header>

  <section class="hero">
    <div class="eyebrow">AN INDEPENDENT RESEARCH JOURNAL</div>
    <h1>Clarity in Thought.<br />Conviction in Perspective.</h1>
    <p>
      Exploring businesses, financial markets, innovation
      and the forces that shape long-term value creation.
    </p>
    <a class="button" href="#insights">Explore Insights →</a>
  </section>

  <main>
    <section id="insights">
      <div class="eyebrow">RESEARCH & PERSPECTIVES</div>
      <h2>Latest Insights</h2>
      <div class="grid">
        {articles.map((article) => (
          <article>
            <div class="eyebrow">{article.category}</div>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="newsletter" id="newsletter">
      <div class="eyebrow">THE WEEKLY THESIS</div>
      <h2>Ideas Worth Thinking About.</h2>
      <p>
        Independent perspectives on businesses,
        markets and investing.
      </p>
      <p>Newsletter subscriptions coming soon.</p>
    </section>
  </main>

  <footer>
    <strong>CAPITAL & CONVICTION</strong>
    <p>Business • Markets • Ideas</p>
    <small>© {new Date().getFullYear()} Capital & Conviction</small>
  </footer>
</body>
</html>
